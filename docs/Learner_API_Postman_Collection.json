				{
					"name": "Learner Login (Auto-saves Bearer Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('learner_token', jsonData.token);",
									"    console.log('Learner token automatically saved to learner_token: ' + jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-API-KEY",
								"value": "{{x_api_key}}",
								"type": "text"
							},
							{
								"key": "device-type",
								"value": "{{device_type}}",
								"type": "text"
							},
							{
								"key": "device-token",
								"value": "{{device_token}}",
								"type": "text"
							},
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"uid\": \"LN000001\",\n    \"mobile\": \"9876543210\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/learner/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"learner",
								"login"
							]
						},
						"description": "Self-service learner login. Username ('uid'): UID or Email. Password ('mobile'): Registered mobile number. Requires device-type and device-token headers. Enforces single-device login."
					},
					"response": []
				},
