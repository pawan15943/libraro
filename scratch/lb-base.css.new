/* ==========================================================================
   Libraro "Apple" design system — shared base (website + auth pages)
   Scope: only pages whose <body> has class "lb". Never affects the portal.
   ========================================================================== */

@font-face {
    font-family: 'Instrument Sans';
    font-style: normal;
    font-weight: 400 700;
    font-stretch: 100%;
    font-display: swap;
    src: url('../fonts/instrument-sans/instrument-sans-latin-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
}
@font-face {
    font-family: 'Instrument Sans';
    font-style: normal;
    font-weight: 400 700;
    font-stretch: 100%;
    font-display: swap;
    src: url('../fonts/instrument-sans/instrument-sans-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+20B9, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

/* ---------- Tokens: light (default) ---------- */
:root {
    --lb-font: 'Instrument Sans', system-ui, -apple-system, 'Segoe UI', Roboto, 'Noto Sans', sans-serif;

    --lb-bg: #fbfbfa;
    --lb-bg-alt: #f0f0ee;
    --lb-surface: #ffffff;
    --lb-surface-2: #f6f6f4;
    --lb-ink: #16171b;
    --lb-ink-2: #3c3d42;
    --lb-muted: #56575d;
    --lb-faint: #6f7077;
    --lb-line: #d9d9dc;
    --lb-line-soft: #ececea;

    /* Brand: navy + teal from the Libraro logo */
    --lb-navy: #18225f;
    --lb-teal: #34939f;
    --lb-primary: #18225f;
    --lb-primary-hover: #232f7e;
    --lb-primary-ink: #ffffff;
    --lb-primary-soft: rgba(24, 34, 95, 0.08);
    --lb-primary-soft-2: rgba(24, 34, 95, 0.05);
    --lb-primary-glow: rgba(24, 34, 95, 0.30);
    --lb-btn: #18225f;
    --lb-link: #18225f;

    --lb-accent: #f8a052;
    --lb-accent-ink: #237a85;
    --lb-page-glow-1: rgba(52, 147, 159, 0.20);
    --lb-page-glow-2: rgba(75, 91, 196, 0.17);
    --lb-page-glow-3: rgba(248, 160, 82, 0.14);
    --lb-page-glow-4: rgba(167, 139, 250, 0.12);
    --lb-page-base: linear-gradient(180deg, #f3f6fd 0%, #f8f9fc 38%, #f4f9f9 72%, #f6f5fb 100%);
    --lb-accent-glow: rgba(248, 160, 82, 0.35);

    --lb-success: #0f8a4f;
    --lb-danger: #c0362c;
    --lb-danger-soft: rgba(192, 54, 44, 0.08);
    --lb-warning: #b45309;

    /* Always-dark "feature" sections (Apple style) */
    --lb-dark: #0c0d10;
    --lb-dark-2: #17181c;
    --lb-dark-3: #1f2026;
    --lb-dark-line: #2a2b31;
    --lb-dark-ink: #f5f5f7;
    --lb-dark-muted: #a1a1a8;

    --lb-nav-bg: rgba(251, 251, 250, 0.78);
    --lb-shadow-lg: 0 24px 60px rgba(0, 0, 0, 0.14);
    --lb-shadow-md: 0 10px 30px rgba(0, 0, 0, 0.08);
    --lb-ease: cubic-bezier(.2, .8, .2, 1);
    --lb-radius-xl: 28px;
    --lb-radius-lg: 24px;
    --lb-radius-md: 14px;
    --lb-pill: 980px;

    color-scheme: light;
}

/* ---------- Tokens: dark ---------- */
:root[data-theme="dark"] {
    --lb-bg: #000000;
    --lb-bg-alt: #111113;
    --lb-surface: #1c1c1e;
    --lb-surface-2: #161618;
    --lb-ink: #f5f5f7;
    --lb-ink-2: #d4d4d9;
    --lb-muted: #a1a1a8;
    --lb-faint: #8d8d95;
    --lb-line: #34353b;
    --lb-line-soft: #26272c;

    --lb-primary: #4b5bc4;
    --lb-primary-hover: #5b6bd2;
    --lb-primary-ink: #ffffff;
    --lb-primary-soft: rgba(75, 91, 196, 0.18);
    --lb-primary-soft-2: rgba(75, 91, 196, 0.10);
    --lb-primary-glow: rgba(75, 91, 196, 0.40);
    --lb-btn: #2b3a9a;
    --lb-link: #9aa6f5;

    --lb-accent-ink: #5cc6d1;
    --lb-page-glow-1: rgba(52, 147, 159, 0.16);
    --lb-page-glow-2: rgba(75, 91, 196, 0.22);
    --lb-page-glow-3: rgba(248, 160, 82, 0.07);
    --lb-page-glow-4: rgba(167, 139, 250, 0.09);
    --lb-page-base: linear-gradient(180deg, #0b0d18 0%, #0a0a0c 45%, #0a0f12 100%);
    --lb-success: #34c77b;
    --lb-danger: #ff6b5e;
    --lb-danger-soft: rgba(255, 107, 94, 0.12);
    --lb-warning: #f8a052;

    --lb-dark: #0d0e11;
    --lb-dark-2: #1a1b20;
    --lb-dark-3: #24252b;

    --lb-nav-bg: rgba(0, 0, 0, 0.72);
    --lb-shadow-lg: 0 24px 60px rgba(0, 0, 0, 0.55);
    --lb-shadow-md: 0 10px 30px rgba(0, 0, 0, 0.45);

    color-scheme: dark;
}

/* ---------- Base ---------- */
/* Soft brand gradient (navy + teal from the logo, a touch of peach & lavender) behind every page */
body.lb::before {
    content: ''; position: fixed; inset: 0; z-index: -1; pointer-events: none;
    background:
        radial-gradient(900px 560px at 0% 0%, var(--lb-page-glow-1), transparent 65%),
        radial-gradient(820px 560px at 100% 8%, var(--lb-page-glow-2), transparent 62%),
        radial-gradient(700px 520px at 85% 92%, var(--lb-page-glow-3), transparent 64%),
        radial-gradient(760px 600px at 8% 100%, var(--lb-page-glow-4), transparent 64%),
        var(--lb-page-base);
}
@media (max-width: 760px) {
    body.lb::before {
        background:
            radial-gradient(520px 420px at 0% 0%, var(--lb-page-glow-1), transparent 70%),
            radial-gradient(480px 420px at 100% 12%, var(--lb-page-glow-2), transparent 68%),
            radial-gradient(460px 400px at 90% 95%, var(--lb-page-glow-3), transparent 68%),
            radial-gradient(480px 420px at 0% 100%, var(--lb-page-glow-4), transparent 68%),
            var(--lb-page-base);
    }
}
body.lb {
    margin: 0;
    background: var(--lb-bg);
    color: var(--lb-ink);
    font-family: var(--lb-font);
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    transition: background-color .3s ease, color .3s ease;
}
.lb *, .lb *::before, .lb *::after { box-sizing: border-box; }
.lb img { max-width: 100%; display: block; }
.lb a { color: var(--lb-link); text-decoration: none; }
.lb a:hover { text-decoration: underline; }
.lb button, .lb input, .lb select, .lb textarea { font-family: inherit; }
.lb h1, .lb h2, .lb h3, .lb h4 { margin: 0; font-weight: 700; letter-spacing: -0.03em; }
.lb p { margin: 0; }
.lb :focus-visible { outline: 2px solid var(--lb-primary); outline-offset: 2px; border-radius: 6px; }
.lb [hidden] { display: none !important; }
.lb .lb-sr-only {
    position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
}
.lb .lb-skip {
    position: absolute; left: 12px; top: -60px; z-index: 200; background: var(--lb-ink); color: var(--lb-bg);
    padding: 10px 16px; border-radius: var(--lb-pill); font-weight: 600; transition: top .2s;
}
.lb .lb-skip:focus { top: 12px; text-decoration: none; }

/* ---------- Icons (sprite: public/img/lb-icons.svg) ---------- */
.lb .lb-i {
    width: 20px; height: 20px; flex: none; display: block;
    fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
}

/* ---------- Logo (light / dark swap) ---------- */
.lb .lb-logo { display: inline-flex; align-items: center; text-decoration: none; }
.lb .lb-logo img { height: 36px; width: auto; }
.lb .lb-logo .lb-logo-dark { display: none; }
:root[data-theme="dark"] .lb .lb-logo .lb-logo-light { display: none; }
:root[data-theme="dark"] .lb .lb-logo .lb-logo-dark { display: block; }

/* ---------- Buttons ---------- */
.lb .lb-btn {
    --_bg: var(--lb-btn); --_fg: var(--lb-primary-ink); --_glow: var(--lb-primary-glow);
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 44px; padding: 12px 24px; border: 0; border-radius: var(--lb-pill);
    background: var(--_bg); color: var(--_fg); font-size: 17px; font-weight: 500; line-height: 1.2;
    cursor: pointer; text-decoration: none; white-space: nowrap;
    transition: transform .45s var(--lb-ease), box-shadow .45s var(--lb-ease), background-color .25s, color .25s, opacity .2s;
    -webkit-tap-highlight-color: transparent;
}
.lb .lb-btn:hover { transform: translateY(-2px) scale(1.03); box-shadow: 0 10px 28px var(--_glow); text-decoration: none; color: var(--_fg); }
.lb .lb-btn:active { transform: scale(.98); }
.lb .lb-btn[disabled], .lb .lb-btn.is-loading { opacity: .65; pointer-events: none; }
.lb .lb-btn--sm { min-height: 34px; padding: 7px 14px; font-size: 13px; font-weight: 600; }
.lb .lb-btn--block { width: 100%; }
.lb .lb-btn--lg { min-height: 52px; font-size: 16px; font-weight: 600; }
.lb .lb-btn--accent { --_bg: var(--lb-accent); --_fg: #16171b; --_glow: var(--lb-accent-glow); }
.lb .lb-btn--ink { --_bg: var(--lb-ink); --_fg: var(--lb-bg); --_glow: rgba(0,0,0,.25); }
.lb .lb-btn--light { --_bg: #ffffff; --_fg: #16171b; --_glow: rgba(255,255,255,.25); }
.lb .lb-btn--ghost {
    --_bg: var(--lb-surface); --_fg: var(--lb-ink); --_glow: rgba(0,0,0,.08);
    border: 1px solid var(--lb-line);
}
.lb .lb-btn--ghost:hover { --_bg: var(--lb-ink); --_fg: var(--lb-bg); border-color: var(--lb-ink); }
.lb .lb-link-arrow {
    display: inline-flex; align-items: center; gap: 4px; padding: 12px 8px;
    font-size: 17px; font-weight: 500; color: var(--lb-primary);
    transition: transform .45s var(--lb-ease);
}
.lb .lb-link-arrow:hover { transform: translateX(4px); text-decoration: none; }
.lb .lb-spinner {
    width: 16px; height: 16px; border-radius: 50%; border: 2px solid currentColor; border-right-color: transparent;
    animation: lb-spin .8s linear infinite; flex: none;
}
@keyframes lb-spin { to { transform: rotate(360deg); } }

/* ---------- Theme toggle ---------- */
.lb .lb-theme-toggle {
    width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--lb-line);
    background: var(--lb-surface); color: var(--lb-ink-2); display: inline-flex; align-items: center; justify-content: center;
    cursor: pointer; padding: 0; transition: background-color .25s, color .25s, transform .3s var(--lb-ease);
}
.lb .lb-theme-toggle:hover { color: var(--lb-ink); transform: rotate(-12deg); }
.lb .lb-theme-toggle .lb-i { width: 18px; height: 18px; }
.lb .lb-theme-toggle .lb-i-moon { display: block; }
.lb .lb-theme-toggle .lb-i-sun { display: none; }
:root[data-theme="dark"] .lb .lb-theme-toggle .lb-i-moon { display: none; }
:root[data-theme="dark"] .lb .lb-theme-toggle .lb-i-sun { display: block; }

/* ---------- Form fields ---------- */
.lb .lb-field { display: flex; flex-direction: column; gap: 7px; min-width: 0; }
.lb .lb-label { font-size: 14px; font-weight: 600; color: var(--lb-ink); display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
.lb .lb-label a { font-weight: 600; font-size: 13px; }
.lb .lb-label .lb-req { color: var(--lb-danger); margin-left: 2px; }
.lb .lb-input {
    display: flex; align-items: center; gap: 10px; height: 52px; padding: 0 16px;
    border-radius: var(--lb-radius-md); background: var(--lb-surface);
    border: 1.5px solid var(--lb-line); transition: border-color .2s, box-shadow .2s, background-color .3s;
}
.lb .lb-input > .lb-i { color: var(--lb-faint); width: 18px; height: 18px; }
.lb .lb-input input, .lb .lb-input select {
    flex: 1; min-width: 0; height: 100%; border: 0; outline: 0; background: none;
    font-size: 16px; font-weight: 500; color: var(--lb-ink); padding: 0;
}
.lb .lb-input input::placeholder { color: var(--lb-faint); font-weight: 400; opacity: 1; }
.lb .lb-input:focus-within { border-color: var(--lb-primary); box-shadow: 0 0 0 4px var(--lb-primary-soft); }
.lb .lb-input.is-invalid { border-color: var(--lb-danger); }
.lb .lb-input.is-invalid:focus-within { box-shadow: 0 0 0 4px var(--lb-danger-soft); }
.lb .lb-input input:-webkit-autofill,
.lb .lb-input input:-webkit-autofill:hover,
.lb .lb-input input:-webkit-autofill:focus {
    -webkit-text-fill-color: var(--lb-ink);
    -webkit-box-shadow: 0 0 0 1000px var(--lb-surface) inset;
    transition: background-color 9999s ease-in-out 0s;
}
.lb .lb-eye {
    width: 36px; height: 36px; margin-right: -8px; border: 0; background: none; border-radius: 10px;
    color: var(--lb-muted); cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 0;
}
.lb .lb-eye:hover { background: var(--lb-bg-alt); color: var(--lb-ink); }
.lb .lb-eye .lb-i { width: 18px; height: 18px; }
.lb .lb-eye .lb-i-eye-off { display: none; }
.lb .lb-eye.is-on .lb-i-eye { display: none; }
.lb .lb-eye.is-on .lb-i-eye-off { display: block; }
.lb .lb-error { font-size: 13px; color: var(--lb-danger); display: flex; align-items: center; gap: 6px; font-weight: 500; }
.lb .lb-error .lb-i { width: 14px; height: 14px; }
.lb .lb-hint { font-size: 13px; color: var(--lb-faint); }

.lb .lb-check { display: flex; align-items: flex-start; gap: 10px; font-size: 15px; line-height: 1.4; color: var(--lb-ink-2); cursor: pointer; }
.lb .lb-check input {
    appearance: none; -webkit-appearance: none; width: 22px; height: 22px; flex: none; margin: 0; border-radius: 7px;
    border: 1.5px solid var(--lb-line); background: var(--lb-surface); cursor: pointer; display: grid; place-items: center;
    transition: background .2s, border-color .2s;
}
.lb .lb-check input::after {
    content: ''; width: 11px; height: 6px; border: 2px solid #fff; border-top: 0; border-right: 0;
    transform: rotate(-45deg) translate(1px, -1px) scale(0); transition: transform .2s var(--lb-ease);
}
.lb .lb-check input:checked { background: var(--lb-primary); border-color: var(--lb-primary); }
.lb .lb-check input:checked::after { transform: rotate(-45deg) translate(1px, -1px) scale(1); }
.lb .lb-check input.is-invalid { border-color: var(--lb-danger); }

/* Strength meter */
.lb .lb-meter { display: flex; align-items: center; gap: 10px; }
.lb .lb-meter-bars { flex: 1; display: flex; gap: 4px; }
.lb .lb-meter-bars span { flex: 1; height: 4px; border-radius: 4px; background: var(--lb-line-soft); transition: background .3s; }
.lb .lb-meter-label { font-size: 13px; font-weight: 600; min-width: 64px; text-align: right; }

/* Alerts (session / server messages) */
.lb .lb-alert {
    display: flex; gap: 10px; align-items: flex-start; padding: 12px 14px; border-radius: 14px;
    font-size: 14px; line-height: 1.45; font-weight: 500; border: 1px solid transparent;
}
.lb .lb-alert .lb-i { width: 18px; height: 18px; margin-top: 1px; }
.lb .lb-alert--success { background: rgba(15, 138, 79, 0.09); border-color: rgba(15, 138, 79, 0.25); color: var(--lb-success); }
.lb .lb-alert--danger { background: var(--lb-danger-soft); border-color: rgba(192, 54, 44, 0.25); color: var(--lb-danger); }
.lb .lb-alert--info { background: var(--lb-primary-soft-2); border-color: var(--lb-primary-soft); color: var(--lb-primary); }
.lb .lb-alert--warning { background: rgba(180, 83, 9, 0.08); border-color: rgba(180, 83, 9, 0.25); color: var(--lb-warning); }

/* Reveal on scroll */
.lb [data-reveal] { transition: opacity .9s var(--lb-ease), transform .9s var(--lb-ease); }
.lb [data-reveal].is-hidden { opacity: 0; transform: translateY(28px); }

/* ==========================================================================
   Motion — load-in, scroll reveal and hover polish (all disabled for reduced motion)
   ========================================================================== */
@keyframes lb-rise { from { opacity: 0; transform: translateY(22px); filter: blur(4px); } to { opacity: 1; transform: none; filter: none; } }
@keyframes lb-fade { from { opacity: 0; } to { opacity: 1; } }
@keyframes lb-zoom-in { from { opacity: 0; transform: scale(1.06); } to { opacity: 1; transform: none; } }
@keyframes lb-nav-in { from { opacity: 0; transform: translateY(-14px); } to { opacity: 1; transform: none; } }
@keyframes lb-drift { 0% { transform: translate3d(0, 0, 0) scale(1); } 50% { transform: translate3d(-2%, 1.5%, 0) scale(1.06); } 100% { transform: translate3d(1.5%, -1%, 0) scale(1.03); } }
@keyframes lb-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
@keyframes lb-shine { from { transform: translateX(-120%) skewX(-20deg); } to { transform: translateX(220%) skewX(-20deg); } }

/* Background gradient breathes slowly */
body.lb::before { animation: lb-drift 26s ease-in-out infinite alternate; will-change: transform; inset: -6%; }

/* Load-in: nav, then the first block of the page, child by child */
.lb .lb-nav { animation: lb-nav-in .7s var(--lb-ease) both; }
.lb :is(.lb-hero, .lb-page-hero, .lb-legal-hero) > *,
.lb .lb-split-inner > *,
.lb .lb-center-card > * { animation: lb-rise .9s var(--lb-ease) both; }
.lb :is(.lb-hero, .lb-page-hero, .lb-legal-hero, .lb-split-inner, .lb-center-card) > :nth-child(1) { animation-delay: .05s; }
.lb :is(.lb-hero, .lb-page-hero, .lb-legal-hero, .lb-split-inner, .lb-center-card) > :nth-child(2) { animation-delay: .14s; }
.lb :is(.lb-hero, .lb-page-hero, .lb-legal-hero, .lb-split-inner, .lb-center-card) > :nth-child(3) { animation-delay: .23s; }
.lb :is(.lb-hero, .lb-page-hero, .lb-legal-hero, .lb-split-inner, .lb-center-card) > :nth-child(4) { animation-delay: .32s; }
.lb :is(.lb-hero, .lb-page-hero, .lb-legal-hero, .lb-split-inner, .lb-center-card) > :nth-child(5) { animation-delay: .41s; }
.lb :is(.lb-hero, .lb-page-hero, .lb-legal-hero, .lb-split-inner, .lb-center-card) > :nth-child(n+6) { animation-delay: .5s; }
.lb .lb-hero-media { animation: lb-zoom-in 1.3s var(--lb-ease) .35s both; }
.lb .lb-split-panel { animation: lb-fade 1s var(--lb-ease) .2s both; }

/* Scroll reveal for cards (classes added by lb-core.js) */
.lb .lb-auto-reveal { transition: opacity .8s var(--lb-ease), transform .8s var(--lb-ease); transition-delay: calc(var(--lb-i, 0) * 80ms); }
.lb .lb-auto-reveal.is-hidden { opacity: 0; transform: translateY(26px) scale(.98); }

/* Buttons: soft light sweep on hover */
.lb .lb-btn { position: relative; overflow: hidden; isolation: isolate; }
.lb .lb-btn::after { content: ''; position: absolute; top: 0; bottom: 0; left: 0; width: 45%; z-index: -1; pointer-events: none; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, .28), transparent); transform: translateX(-120%) skewX(-20deg); }
.lb .lb-btn:hover::after { animation: lb-shine .9s var(--lb-ease); }
.lb .lb-btn .lb-i { transition: transform .35s var(--lb-ease); }
.lb .lb-btn:hover .lb-i:last-child:not(:first-child) { transform: translateX(3px); }
.lb .lb-link-arrow .lb-i { transition: transform .35s var(--lb-ease); }
.lb .lb-link-arrow:hover .lb-i { transform: translateX(3px); }

/* Nav links: underline grows from the centre */
.lb .lb-nav-links a::before { content: ''; position: absolute; left: 50%; right: 50%; bottom: 0; height: 2px; border-radius: 2px; background: var(--lb-teal); transition: left .35s var(--lb-ease), right .35s var(--lb-ease); }
.lb .lb-nav-links a:hover::before { left: 0; right: 0; }

/* Cards: lift, glow and a light that follows the cursor (--mx/--my set by lb-core.js) */
.lb :is(.lb-value, .lb-contact-card, .lb-who-card, .lb-lib, .lb-post-card, .lb-related-card, .lb-legal-sec, .lb-review, .lb-plan, .lb-truststrip li, .lb-facility, .lb-fact) {
    transition: transform .45s var(--lb-ease), box-shadow .45s var(--lb-ease), border-color .3s;
}
.lb :is(.lb-value, .lb-contact-card, .lb-who-card, .lb-lib, .lb-post-card, .lb-related-card, .lb-review, .lb-truststrip li):hover {
    transform: translateY(-5px); box-shadow: 0 22px 44px -22px rgba(24, 34, 95, .4);
}
.lb .lb-plan:hover { transform: translateY(-6px); }
.lb .lb-spot { position: relative; }
.lb .lb-spot::after {
    content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; z-index: 1; opacity: 0; transition: opacity .35s;
    background: radial-gradient(360px circle at var(--mx, 50%) var(--my, 50%), rgba(255, 255, 255, .22), transparent 60%);
}
:root[data-theme="dark"] .lb .lb-spot::after { background: radial-gradient(360px circle at var(--mx, 50%) var(--my, 50%), rgba(127, 214, 223, .10), transparent 60%); }
.lb .lb-spot:hover::after { opacity: 1; }

/* Icon tiles wiggle a little when their card is hovered */
.lb :is(.lb-pain-ico, .lb-op-icon, .lb-suite-icon, .lb-legal-glance li > i, .lb-truststrip li > i, .lb-contact-card i, .lb-value > i) { transition: transform .45s cubic-bezier(.34, 1.56, .64, 1); }
.lb .lb-pain:hover .lb-pain-ico, .lb .lb-op:hover .lb-op-icon, .lb .lb-suite-panel:hover .lb-suite-icon, .lb .lb-legal-glance li:hover > i, .lb .lb-truststrip li:hover > i, .lb .lb-contact-card:hover > i, .lb .lb-value:hover > i { transform: translateY(-2px) rotate(-6deg) scale(1.08); }

/* Images inside cards zoom gently */
.lb :is(.lb-op-photo, .lb-lib-cover, .lb-related-img, .lb-featured-img) { overflow: hidden; }
.lb :is(.lb-op-photo, .lb-lib-cover, .lb-related-img, .lb-featured-img) img { transition: transform .8s var(--lb-ease); }
.lb :is(.lb-op, .lb-lib, .lb-related-card, .lb-featured):hover :is(.lb-op-photo, .lb-lib-cover, .lb-related-img, .lb-featured-img) img { transform: scale(1.06); }

/* Small floating touches */
.lb .lb-legal-badge, .lb .lb-vs2-badge { animation: lb-float 4.5s ease-in-out infinite; }
.lb .lb-vs2-badge { animation-name: lb-float-x; }
@keyframes lb-float-x { 0%, 100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(-6px); } }

/* Tabs / pills press feedback */
.lb :is(.lb-suite-tabs button, .lb-legal-tabs a, .lb-billing button, .lb-chip) { transition: transform .25s var(--lb-ease), background .25s, color .25s, border-color .25s, box-shadow .25s; }
.lb :is(.lb-suite-tabs button, .lb-legal-tabs a, .lb-chip):hover { transform: translateY(-1px); }
.lb :is(.lb-suite-tabs button, .lb-legal-tabs a, .lb-billing button, .lb-chip):active { transform: scale(.96); }

@media (prefers-reduced-motion: reduce) {
    .lb *, .lb *::before, .lb *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; scroll-behavior: auto !important; }
    .lb [data-reveal].is-hidden, .lb .lb-auto-reveal.is-hidden { opacity: 1; transform: none; }
    body.lb::before { animation: none; }
}

/* Large cards that sit straight on the page gradient: frosted glass instead of flat grey */
body.lb .lb-contact-card, body.lb .lb-value, body.lb .lb-step3, body.lb .lb-empty-state {
    background: color-mix(in srgb, var(--lb-surface) 70%, transparent);
    border: 1px solid var(--lb-line-soft);
    -webkit-backdrop-filter: blur(14px) saturate(1.3); backdrop-filter: blur(14px) saturate(1.3);
}
body.lb .lb-contact-card i, body.lb .lb-value > i { background: var(--lb-primary-soft); color: var(--lb-link); }
